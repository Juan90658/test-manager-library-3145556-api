APP_NAME="Manager Library"
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Database (empty engine started by the infra repo; migrations create the schema)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=library
DB_USERNAME=library
DB_PASSWORD=

# No session, cache or queue tables: the data model has six tables and nothing else.
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# JWT HS256 token, 8 hours. Long random string (openssl rand -hex 32). Never in the repo.
JWT_SECRET=

# Initial admin: created by `php artisan library:bootstrap-admin` at startup. Never in the repo.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Covers: binary on disk; the database only stores an opaque key.
COVERS_DIR=storage/app/covers

# The only origin allowed by CORS (the frontend).
CORS_ORIGIN=http://localhost:5173

# Demo seeder only (tool repo): shifts the Clock port by N days.
# Empty or 0 in normal operation.
CLOCK_OFFSET_DAYS=0
